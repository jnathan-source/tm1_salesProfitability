#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
SetInputCharacterSet('TM1CS_ISO_8859_1');
vType='N';
vWeight=1.0;
nElem=ElementCount('Customer','Customer');
while(nElem>0);
HierarchyElementDelete('Customer','Customer',ElementName('Customer','Customer',nElem));
nElem=nElem-1;
End;
lastAttr='';
iAttr=DIMSIZ('}ElementAttributes_Customer');
i=iAttr;
While(i > 0);
attrName = DIMNM('}ElementAttributes_Customer', i);
If(SUBST(attrName,0,1)@<>'}');
lastAttr=attrName;
i=0;
Else;
i=i-1;
EndIf;
End;
ElementAttrInsert('Customer','Customer',lastAttr,'Customer Name','A');
lastAttr = 'Customer Name';
ElementAttrInsert('Customer','Customer',lastAttr,'Customer Name','A');
lastAttr = 'Customer Name';
ElementAttrInsert('Customer','Customer',lastAttr,'Zipcode','S');
lastAttr = 'Zipcode';
ElementAttrInsert('Customer','Customer',lastAttr,'Customer Name','A');
lastAttr = 'Customer Name';
ElementAttrInsert('Customer','Customer',lastAttr,'Country Code','S');
lastAttr = 'Country Code';
ElementAttrInsert('Customer','Customer',lastAttr,'Customer Address','S');
lastAttr = 'Customer Address';
#endregion
#region Metadata
vLastMember='';
If(customer_id@<>'');
If(vLastMember@='');
HierarchyElementInsert('Customer','Customer','',customer_id,vType);
Else;
If(HierarchyElementExists('Customer','Leaves',customer_id)=1);
StringToNumber('IMPERROR_CL_'|customer_id);
EndIf;
HierarchyElementInsert('Customer','Customer','',customer_id,'C');
HierarchyElementComponentAdd('Customer','Customer',customer_id,vLastMember,vWeight);
EndIf;
vLastMember=customer_id;
EndIf;
If(concat2@<>'');
If(vLastMember@='');
HierarchyElementInsert('Customer','Customer','',concat2,vType);
Else;
If(HierarchyElementExists('Customer','Leaves',concat2)=1);
StringToNumber('IMPERROR_CL_'|concat2);
EndIf;
HierarchyElementInsert('Customer','Customer','',concat2,'C');
HierarchyElementComponentAdd('Customer','Customer',concat2,vLastMember,vWeight);
EndIf;
vLastMember=concat2;
EndIf;
If(concat3@<>'');
If(vLastMember@='');
HierarchyElementInsert('Customer','Customer','',concat3,vType);
Else;
If(HierarchyElementExists('Customer','Leaves',concat3)=1);
StringToNumber('IMPERROR_CL_'|concat3);
EndIf;
HierarchyElementInsert('Customer','Customer','',concat3,'C');
HierarchyElementComponentAdd('Customer','Customer',concat3,vLastMember,vWeight);
EndIf;
vLastMember=concat3;
EndIf;
#endregion
#region Data
If(customer_id@<>'');
ElementAttrPutS(concat,'Customer','Customer',customer_id,'Customer Name');
EndIf;
If(concat2@<>'');
ElementAttrPutS(city_name,'Customer','Customer',concat2,'Customer Name');
EndIf;
If(customer_id@<>'');
ElementAttrPutS(zipcode,'Customer','Customer',customer_id,'Zipcode');
EndIf;
If(concat3@<>'');
ElementAttrPutS(country_name,'Customer','Customer',concat3,'Customer Name');
EndIf;
If(customer_id@<>'');
ElementAttrPutS(country_code,'Customer','Customer',customer_id,'Country Code');
EndIf;
If(customer_id@<>'');
ElementAttrPutS(address,'Customer','Customer',customer_id,'Customer Address');
EndIf;
#endregion