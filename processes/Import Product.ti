#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
SetInputCharacterSet('TM1CS_ISO_8859_2');
vType='N';
vWeight=1.0;
nElem=ElementCount('Product','Product');
while(nElem>0);
HierarchyElementDelete('Product','Product',ElementName('Product','Product',nElem));
nElem=nElem-1;
End;
lastAttr='';
iAttr=DIMSIZ('}ElementAttributes_Product');
i=iAttr;
While(i > 0);
attrName = DIMNM('}ElementAttributes_Product', i);
If(SUBST(attrName,0,1)@<>'}');
lastAttr=attrName;
i=0;
Else;
i=i-1;
EndIf;
End;
#endregion
#region Metadata
vLastMember='';
If(product_id@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',product_id,vType);
Else;
If(HierarchyElementExists('Product','Leaves',product_id)=1);
StringToNumber('IMPERROR_CL_'|product_id);
EndIf;
HierarchyElementInsert('Product','Product','',product_id,'C');
HierarchyElementComponentAdd('Product','Product',product_id,vLastMember,vWeight);
EndIf;
vLastMember=product_id;
EndIf;
If(concat@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',concat,vType);
Else;
If(HierarchyElementExists('Product','Leaves',concat)=1);
StringToNumber('IMPERROR_CL_'|concat);
EndIf;
HierarchyElementInsert('Product','Product','',concat,'C');
HierarchyElementComponentAdd('Product','Product',concat,vLastMember,vWeight);
EndIf;
vLastMember=concat;
EndIf;
If(column@<>'');
If(vLastMember@='');
HierarchyElementInsert('Product','Product','',column,vType);
Else;
If(HierarchyElementExists('Product','Leaves',column)=1);
StringToNumber('IMPERROR_CL_'|column);
EndIf;
HierarchyElementInsert('Product','Product','',column,'C');
HierarchyElementComponentAdd('Product','Product',column,vLastMember,vWeight);
EndIf;
vLastMember=column;
EndIf;
#endregion
#region Data
If(product_id@<>'');
ElementAttrPutS(product_name,'Product','Product',product_id,'Product Name');
EndIf;
If(product_id@<>'');
ElementAttrPutS(category_name,'Product','Product',product_id,'Product Name');
EndIf;
If(product_id@<>'');
ElementAttrPutS(modify_date,'Product','Product',product_id,'Modified Date');
EndIf;
If(product_id@<>'');
ElementAttrPutS(class,'Product','Product',product_id,'Product Class');
EndIf;
If(product_id@<>'');
ElementAttrPutS(resistant,'Product','Product',product_id,'Resistance');
EndIf;
If(product_id@<>'');
ElementAttrPutS(isallergic,'Product','Product',product_id,'IsAllergic');
EndIf;
If(product_id@<>'');
ElementAttrPutN(vitality_days,'Product','Product',product_id,'Vitality Days');
EndIf;
#endregion