#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
CurrentLogSetting = CubeGetLogChanges('Sales');
CubeSetLogChanges('Sales', 0);
NumMetaRowsRead = 0;
NumMetaRowsProcessed = 0;
NumRowsRead = 0;
NumRowsProcessed = 0;
SetInputCharacterSet('TM1CS_ISO_8859_2');
#endregion
#region Metadata
NumMetaRowsRead = NumMetaRowsRead + 1;
If(column@<>'');
HierarchyElementInsert('Version','Version','',column,'N');
EndIf;
If(product_id@<>'');
HierarchyElementInsert('Product','Product','',product_id,'N');
EndIf;
If(customer_id@<>'');
HierarchyElementInsert('Customer','Customer','',customer_id,'N');
EndIf;
If(timeperiod@<>'');
HierarchyElementInsert('TimePeriod','TimePeriod','',timeperiod,'N');
EndIf;
NumMetaRowsProcessed = NumMetaRowsProcessed + 1;
#endregion
#region Data
NumRowsRead = NumRowsRead + 1;
If (quantity @<> '');
CellPutN(StringToNumberEx(quantity,'.',','),'Sales',column,product_id,customer_id,timeperiod,'Quantity');
NumRowsProcessed = NumRowsProcessed + 1;
EndIf;
#endregion
#region Epilog
If (pResult @<> '');
TextOutput(pResult, NumberToString(NumRowsRead), NumberToString(NumRowsProcessed), NumberToString(NumMetaRowsRead), NumberToString(NumMetaRowsProcessed));
EndIf;
CubeSaveData('Sales');
CubeSetLogChanges('Sales', CurrentLogSetting);
#endregion